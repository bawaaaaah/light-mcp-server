{
  "name": "light-mcp-server",
  "version": "0.0.1",
  "description": "Contrôleur lumière DMX (Art-Net / sACN) piloté en web, MIDI, OSC et MCP",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "mocha --import=tsx --require test/setup/no-unhandled-errors.ts 'test/**/*.test.ts' --recursive --timeout 20000",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "proto:midi": "tsx prototypes/p1-midi-monitor.ts",
    "proto:tick": "tsx prototypes/p2-tick-bench.ts",
    "proto:adg": "tsx prototypes/p3-adg-rack.ts",
    "proto:artnet": "tsx prototypes/p6-artnet-discover.ts",
    "proto:fake-node": "tsx prototypes/fake-artnet-node.ts",
    "proto:rtp": "tsx prototypes/p7-rtp-midi.ts",
    "proto:ws": "tsx prototypes/p9-ws-stream.ts",
    "proto:sacn": "tsx prototypes/p10-sacn.ts",
    "proto:osc": "tsx prototypes/p11-osc.ts",
    "proto:qxw": "tsx prototypes/p12-qxw-import.ts",
    "proto:liveset": "tsx prototypes/p8-live-set.ts",
    "light": "tsx src/cli/main.ts",
    "serve": "tsx src/cli/main.ts serve",
    "build:web": "npm --prefix web run build",
    "dev:web": "npm --prefix web run dev",
    "build": "tsc -p tsconfig.build.json && cp src/plugins/light/knowledge/generic.json dist/plugins/light/knowledge/ && npm --prefix web run build",
    "start": "node dist/cli/main.js serve"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "chai": "^6.3.0",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@julusian/midi": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@msgpack/msgpack": "^3.1.3",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "ws": "^8.22.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@julusian/midi@3.8.1": true
  },
  "bin": {
    "light": "dist/cli/main.js"
  }
}
