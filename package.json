{
  "name": "@bawaaaaah/light-mcp-server",
  "version": "0.1.0",
  "description": "Contrôleur lumière DMX (Art-Net / sACN) piloté en web, MIDI, OSC et MCP — import QLC+, export Ableton",
  "keywords": [
    "dmx",
    "art-net",
    "sacn",
    "lighting",
    "midi",
    "osc",
    "mcp",
    "model-context-protocol",
    "qlc",
    "ableton"
  ],
  "license": "MIT",
  "homepage": "https://github.com/bawaaaaah/light-mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bawaaaaah/light-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/bawaaaaah/light-mcp-server/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "light": "./dist/cli/main.js",
    "light-mcp-server": "./dist/cli/main.js"
  },
  "files": [
    "dist/",
    "web/dist/",
    "sdk/",
    "docs/install.md",
    "docs/install-npm.md",
    "docs/bascule-qlc.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "test": "mocha --import=tsx --require test/setup/no-unhandled-errors.ts 'test/**/*.test.ts' --recursive --timeout 20000",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "proto:midi": "tsx prototypes/p1-midi-monitor.ts",
    "proto:tick": "tsx prototypes/p2-tick-bench.ts",
    "proto:adg": "tsx prototypes/p3-adg-rack.ts",
    "proto:artnet": "tsx prototypes/p6-artnet-discover.ts",
    "proto:fake-node": "tsx prototypes/fake-artnet-node.ts",
    "proto:rtp": "tsx prototypes/p7-rtp-midi.ts",
    "proto:ws": "tsx prototypes/p9-ws-stream.ts",
    "proto:sacn": "tsx prototypes/p10-sacn.ts",
    "proto:osc": "tsx prototypes/p11-osc.ts",
    "proto:qxw": "tsx prototypes/p12-qxw-import.ts",
    "proto:liveset": "tsx prototypes/p8-live-set.ts",
    "light": "tsx src/cli/main.ts",
    "serve": "tsx src/cli/main.ts serve",
    "build:web": "npm --prefix web run build",
    "dev:web": "npm --prefix web run dev",
    "build": "tsc -p tsconfig.build.json && cp src/plugins/light/knowledge/generic.json dist/plugins/light/knowledge/ && npm --prefix web run build",
    "start": "node dist/cli/main.js serve",
    "test:ui": "playwright test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/chai": "^5.2.3",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "chai": "^6.3.0",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@julusian/midi": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@msgpack/msgpack": "^3.1.3",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "ws": "^8.22.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@julusian/midi@3.8.1": true
  },
  "types": "./dist/index.d.ts"
}
