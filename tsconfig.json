{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "noEmit": true,
    "types": ["node", "mocha", "chai"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "prototypes/**/*.ts"],
  "exclude": ["node_modules", "dist", "web"]
}
