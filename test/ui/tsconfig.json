{
  // The UI tests run in Node but hand callbacks to the browser (page.evaluate, locator.evaluate):
  // they need the DOM types the root config leaves out for the server code. The root config skips
  // this folder, so each spec is checked once.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["**/*.ts"],
  // the root config leaves test/ui out (checked once, here, with the DOM types): not inherited
  "exclude": []
}
