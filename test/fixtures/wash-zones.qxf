<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic wash for the head deduction (T21): no <Head>, three numbered RGBW zones and a halo RGB with its own effect. -->
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Manufacturer>Test</Manufacturer>
 <Model>Wash Zones</Model>
 <Type>Color Changer</Type>
 <Channel Name="Dimmer" Preset="IntensityMasterDimmer"/>
 <Channel Name="Strobe">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="10" Preset="ShutterOpen">Strobe Off</Capability>
  <Capability Min="11" Max="255" Preset="StrobeSlowToFast">Strobe</Capability>
 </Channel>
 <Channel Name="Red 1" Preset="IntensityRed"/>
 <Channel Name="Green 1" Preset="IntensityGreen"/>
 <Channel Name="Blue 1" Preset="IntensityBlue"/>
 <Channel Name="White 1" Preset="IntensityWhite"/>
 <Channel Name="Red 2" Preset="IntensityRed"/>
 <Channel Name="Green 2" Preset="IntensityGreen"/>
 <Channel Name="Blue 2" Preset="IntensityBlue"/>
 <Channel Name="White 2" Preset="IntensityWhite"/>
 <Channel Name="Red 3" Preset="IntensityRed"/>
 <Channel Name="Green 3" Preset="IntensityGreen"/>
 <Channel Name="Blue 3" Preset="IntensityBlue"/>
 <Channel Name="White 3" Preset="IntensityWhite"/>
 <Channel Name="Halo Red" Preset="IntensityRed"/>
 <Channel Name="Halo Green" Preset="IntensityGreen"/>
 <Channel Name="Halo Blue" Preset="IntensityBlue"/>
 <Channel Name="Halo Effect">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="127">No function</Capability>
  <Capability Min="128" Max="255">Rainbow</Capability>
 </Channel>
 <Mode Name="18 Channel">
  <Channel Number="0">Dimmer</Channel>
  <Channel Number="1">Strobe</Channel>
  <Channel Number="2">Red 1</Channel><Channel Number="3">Green 1</Channel><Channel Number="4">Blue 1</Channel><Channel Number="5">White 1</Channel>
  <Channel Number="6">Red 2</Channel><Channel Number="7">Green 2</Channel><Channel Number="8">Blue 2</Channel><Channel Number="9">White 2</Channel>
  <Channel Number="10">Red 3</Channel><Channel Number="11">Green 3</Channel><Channel Number="12">Blue 3</Channel><Channel Number="13">White 3</Channel>
  <Channel Number="14">Halo Red</Channel><Channel Number="15">Halo Green</Channel><Channel Number="16">Halo Blue</Channel>
  <Channel Number="17">Halo Effect</Channel>
 </Mode>
</FixtureDefinition>
